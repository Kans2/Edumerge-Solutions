NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGO_URI=your uri

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TZ=Asia/Kolkata

# Attendance policy defaults (overridable per institution/term)
MIN_ATTENDANCE_PERCENT=75
CONDONATION_FLOOR_PERCENT=65
EDIT_WINDOW_HOURS=24
LOCK_AFTER_HOURS=48
DEFAULT_MARK=PRESENT
EXCUSED_COUNTS_AS_PRESENT=true

# Jobs
ENABLE_JOBS=true
SUMMARY_CRON=0 1 * * *
LOCK_CRON=0 * * * *
SESSION_GEN_CRON=0 0 * * 0
LOW_ATT_ALERT_CRON=0 7 * * 1

MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Attendance Office <no-reply@college.edu>"
